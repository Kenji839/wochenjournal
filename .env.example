# Google Gemini API-Key (serverseitig, nie im Client). Lokal in .env.local setzen.
# Key erstellen unter: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Modell überschreiben (Default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# Confluence-Zugangsdaten (serverseitig, nie im Client). Lokal in .env.local setzen.
# Benutzername fuer Confluence, z. B. you.you@sbb.ch
CONFLUENCE_USERNAME=
# Personal Access Token (PAT) zur Authentifizierung gegenueber Confluence
CONFLUENCE_PAT=
# Basis-URL der Confluence-Instanz, z. B. https://confluence.yourDomain
CONFLUENCE_BASE_URL=
# Space-Key, in dem die KW-Seiten liegen, z. B. ~e550226
CONFLUENCE_SPACE_KEY=
# pageId der Wurzelseite, unter der die KW-Seiten als Unterseiten erstellt werden
CONFLUENCE_ROOT_PAGE_ID=
# Username/Email von Konto
CONFLUENCE_USERNAME=
# Passwort von Konto
CONFLUENCE_PASS=
# Ort wo die MDs der Journale gespeichert sind
CONTENT_ROOT=
# Optional: Pfad(e) zu lokalen Git-Repositories, aus denen Commit-Titel als
# Tagesstichworte gelesen werden. Relative Pfade werden gegen das
# Arbeitsverzeichnis des Servers aufgeloest. Mehrere Repositories koennen
# kommagetrennt angegeben werden; ihre Commits werden pro Wochentag
# zusammengefuehrt. Beispiel: ../inclusive-app-backend,../anderes-projekt
GIT_REPO_PATH=
